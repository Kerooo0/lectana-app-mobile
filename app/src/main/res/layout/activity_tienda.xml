<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white">

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvTituloTienda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tienda de Avatares"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvPuntosActuales"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Puntos disponibles: 0"
            android:textSize="16sp"
            android:textColor="@android:color/holo_blue_dark"
            android:gravity="center" />
    </LinearLayout>

    <!-- RecyclerView con Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAvataresTienda"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp" />

    <!-- ProgressBar -->
    <ProgressBar
        android:id="@+id/pbCargandoTienda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />
</LinearLayout>


