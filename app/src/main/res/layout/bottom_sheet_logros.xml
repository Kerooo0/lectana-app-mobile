<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mis Logros"
            android:textColor="@color/gris_oscuro"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_cerrar_logros"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_check_circle"
            android:tint="@color/gris_medio"
            android:contentDescription="Cerrar" />

    </LinearLayout>

    <!-- Estadísticas rápidas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/estadistica_desbloqueados"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/verde_principal"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Desbloqueados"
                android:textColor="@color/gris_medio"
                android:textSize="12sp" />

        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/gris_claro" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/estadistica_totales"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/gris_oscuro"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Totales"
                android:textColor="@color/gris_medio"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- RecyclerView de logros -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_logros_expandido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false" />

    <!-- Mensaje vacío -->
    <TextView
        android:id="@+id/texto_sin_logros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No hay logros disponibles"
        android:textAlignment="center"
        android:textColor="@color/gris_medio"
        android:textSize="14sp"
        android:paddingVertical="24dp"
        android:visibility="gone" />

</LinearLayout>
