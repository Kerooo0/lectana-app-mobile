<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:layout_margin="8dp"
    android:background="@drawable/boton_borde">

    <!-- Imagen del Avatar -->
    <ImageView
        android:id="@+id/imagen_avatar_tienda"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:scaleType="centerInside"
        android:contentDescription="Avatar"
        android:layout_marginBottom="8dp" />

    <!-- Nombre del Avatar -->
    <TextView
        android:id="@+id/nombre_avatar_tienda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre Avatar"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="4dp"
        android:gravity="center" />

    <!-- Descripción -->
    <TextView
        android:id="@+id/descripcion_avatar_tienda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descripción del avatar"
        android:textSize="12sp"
        android:textColor="@color/design_default_color_secondary"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Precio -->
    <TextView
        android:id="@+id/precio_avatar_tienda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 pts"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@android:color/holo_blue_dark"
        android:layout_marginBottom="8dp"
        android:gravity="center" />

    <!-- Botón Comprar -->
    <Button
        android:id="@+id/btn_comprar_avatar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="Comprar"
        android:background="@drawable/boton_azul_rectangular"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />
</LinearLayout>
